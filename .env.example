# ---------------------------------------------------------------------------
# Rafiq — environment
# Copy to .env.local for development. Set the same keys in Vercel project
# settings for preview/production. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the postback handler and the subscription charger,
# which act outside a user session and must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Collection gateway (server-only; never expose to the browser) --------
# Base URL WITHOUT the gateway prefix. The client appends /mock/collection.
COLLECTION_BASE_URL=https://your-public-gateway-host
COLLECTION_GATEWAY_PREFIX=/mock/collection

# A real seeded 7-digit MID. Every request answers 0003 without one.
COLLECTION_MERCHANT_ID=2000010
# Merchant key — required by the Hosted Page /checkout launch only.
COLLECTION_MERCHANT_KEY=your-merchant-key
# Which flow this MID is provisioned on: "otp" or "non_otp". Calling the other
# one's sequence answers 0015 Invalid-Flow.
COLLECTION_FLOW=otp
# Shared secret used to sign refund requests.
COLLECTION_REFUND_SIGNING_SECRET=your-refund-secret

# Region/mode/version headers. Only change these if the gateway tells you to —
# a version other than 3.0 selects a QA fixture on direct-payment/delink.
COLLECTION_REGION=PK
COLLECTION_MODE=payin
COLLECTION_VERSION=3.0

# --- App ------------------------------------------------------------------
# Public origin, used to build ReturnUrl/redirectUrl for hosted flows.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret the gateway must present on POST /api/collection/postback.
COLLECTION_POSTBACK_SECRET=generate-a-long-random-string
# Secret guarding POST /api/cron/charge-subscriptions (Vercel Cron header).
CRON_SECRET=generate-another-long-random-string
