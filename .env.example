# ---------------------------------------------------------------------------
# Rafiq — environment
# Copy to .env.local for development. Set the same keys in Vercel project
# settings for preview/production. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…). Ships to the browser by design; RLS is
# what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_…). Server-only, bypasses RLS. Used by the postback
# handler and the subscription charger, which act outside a user session.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Optional: bootstrap fallbacks ----------------------------------------
# Base URL, merchant ID and flow live in the `gateway_settings` table and are
# edited from /settings (admin-only). These three are OPTIONAL overrides for
# bootstrapping or CI — leave them blank and set the values in the app instead.
# The database row wins whenever it is set. If a value is in neither place,
# checkout refuses with a clear message rather than sending a request that
# cannot succeed.

# The full base URL, gateway prefix INCLUDED — endpoint paths are appended to it
# verbatim, starting at the version segment. The value below means a payment is
# sent to http://3.127.43.66:8001/mock/collection/v2/wallets/transaction/verify
COLLECTION_BASE_URL=http://3.127.43.66:8001/mock/collection

# Three real seeded 7-digit MIDs, one per job. COLLECTION_FLOW below picks
# which of the two payment merchants is live; tokenization is not selectable and
# is used alongside whichever that is. Every request answers 0003 without one.
COLLECTION_MERCHANT_ID_OTP=
COLLECTION_MERCHANT_ID_NON_OTP=
# Saved wallets: linking, one-click charges, subscription renewals, delink.
# A token belongs to the merchant that minted it, so this one deliberately has
# NO fallback to the payment MID — inheriting it would mint tokens that answer
# 0003 the first time they are charged.
COLLECTION_MERCHANT_ID_TOKENIZATION=
# Legacy single-merchant fallback for the two payment slots only.
COLLECTION_MERCHANT_ID=
# Merchant key — required by the Hosted Page /checkout launch only.
COLLECTION_MERCHANT_KEY=your-merchant-key
# Which flow is live: "otp" or "non_otp". This selects the merchant as well as
# the sequence. Calling a MID on the other flow answers 0015 Invalid-Flow.
# There is no default on purpose — guessing would send half of all merchants
# down the wrong sequence.
COLLECTION_FLOW=
# Shared secret used to sign refund requests.
COLLECTION_REFUND_SIGNING_SECRET=your-refund-secret

# Region/mode/version headers. Only change these if the gateway tells you to —
# a version other than 3.0 selects a QA fixture on direct-payment/delink.
COLLECTION_REGION=PK
COLLECTION_MODE=payin
COLLECTION_VERSION=3.0

# --- App ------------------------------------------------------------------
# Public origin, used to build ReturnUrl/redirectUrl for hosted flows.
NEXT_PUBLIC_APP_URL=http://localhost:4000
# Shared secret the gateway must present on POST /api/collection/postback.
COLLECTION_POSTBACK_SECRET=generate-a-long-random-string
# Secret guarding POST /api/cron/charge-subscriptions (Vercel Cron header).
CRON_SECRET=generate-another-long-random-string

# How linking an Easypaisa wallet runs. Optional bootstrap override; the
# `gateway_settings` row and /settings win over it.
#   initiate_verify  guide §2 — initiate sends the OTP, verify redeems it
#   verify_only      the gateway answers 0015 to any initiate with
#                    transactionType 8; verify mints the token on its own
# Unset defaults to initiate_verify.
COLLECTION_TOKENIZATION_SEQUENCE=
